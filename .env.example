# Runtime
NODE_ENV=development
API_PORT=4000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Local PostgreSQL and Prisma
POSTGRES_DB=eventure
POSTGRES_USER=eventure
POSTGRES_PASSWORD=eventure_dev_only
DATABASE_URL=postgresql://eventure:eventure_dev_only@localhost:5432/eventure?schema=public

# Authentication - replace these values in every real environment
JWT_ACCESS_SECRET=replace-with-a-random-secret-that-is-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-random-secret-at-least-32-characters
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

# SMTP / Nodemailer
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASS=replace-me
MAIL_FROM=Eventure <noreply@example.com>

# Deterministic development seed accounts
DEMO_CUSTOMER_EMAIL=customer@eventure.local
DEMO_CUSTOMER_PASSWORD=Customer123!
DEMO_ORGANIZER_EMAIL=organizer@eventure.local
DEMO_ORGANIZER_PASSWORD=Organizer123!
