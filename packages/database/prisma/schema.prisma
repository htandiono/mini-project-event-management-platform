generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ORGANIZER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELED
  COMPLETED
}

enum TransactionStatus {
  WAITING_FOR_PAYMENT
  WAITING_FOR_CONFIRMATION
  DONE
  REJECTED
  EXPIRED
  CANCELED
}

enum PointEntryType {
  CREDIT
  DEBIT
  RESTORE
  EXPIRE
}

enum UserCouponStatus {
  ACTIVE
  REDEEMED
  EXPIRED
  RESTORED
}

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  passwordHash        String
  name                String
  role                UserRole
  status              UserStatus @default(ACTIVE)
  referralCode        String     @unique
  referredById        String?
  avatarUrl           String?
  avatarPublicId      String?
  passwordResetToken  String?    @unique
  resetTokenExpiresAt DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?

  referredBy      User?         @relation("UserReferrals", fields: [referredById], references: [id])
  referrals       User[]        @relation("UserReferrals")
  organizedEvents Event[]       @relation("EventOrganizer")
  transactions    Transaction[] @relation("CustomerTransactions")
  pointEntries    PointLedger[]
  coupons         UserCoupon[]
  reviews         Review[]

  @@index([role, deletedAt])
  @@index([referredById])
}

model PointLedger {
  id            String         @id @default(cuid())
  userId        String
  transactionId String?
  type          PointEntryType
  amount        Int
  description   String
  expiresAt     DateTime?
  createdAt     DateTime       @default(now())

  user        User         @relation(fields: [userId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@index([userId, expiresAt])
  @@index([transactionId])
}

model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  name            String
  discountPercent Int
  validityDays    Int       @default(90)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  userCoupons UserCoupon[]

  @@index([deletedAt])
}

model UserCoupon {
  id         String           @id @default(cuid())
  userId     String
  couponId   String
  status     UserCouponStatus @default(ACTIVE)
  expiresAt  DateTime
  redeemedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user        User         @relation(fields: [userId], references: [id])
  coupon      Coupon       @relation(fields: [couponId], references: [id])
  transaction Transaction?

  @@unique([userId, couponId])
  @@index([userId, status, expiresAt])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  events Event[]

  @@index([deletedAt])
}

model Event {
  id                String      @id @default(cuid())
  organizerId       String
  categoryId        String
  name              String
  slug              String      @unique
  description       String
  venue             String
  address           String
  city              String
  province          String
  startsAt          DateTime
  endsAt            DateTime
  capacity          Int
  availableSeats    Int
  isFree            Boolean     @default(false)
  thumbnailUrl      String?
  thumbnailPublicId String?
  status            EventStatus @default(DRAFT)
  publishedAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?

  organizer    User          @relation("EventOrganizer", fields: [organizerId], references: [id])
  category     Category      @relation(fields: [categoryId], references: [id])
  ticketTypes  TicketType[]
  vouchers     Voucher[]
  transactions Transaction[]
  reviews      Review[]

  @@index([status, startsAt, deletedAt])
  @@index([categoryId, city])
  @@index([organizerId, deletedAt])
}

model TicketType {
  id             String    @id @default(cuid())
  eventId        String
  name           String
  description    String?
  price          Int
  capacity       Int
  availableSeats Int
  salesStartAt   DateTime?
  salesEndAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  event            Event             @relation(fields: [eventId], references: [id])
  transactionItems TransactionItem[]

  @@unique([eventId, name])
  @@index([eventId, deletedAt])
}

model Voucher {
  id              String    @id @default(cuid())
  eventId         String
  code            String    @unique
  name            String
  discountPercent Int?
  discountAmount  Int?
  usageLimit      Int
  usedCount       Int       @default(0)
  startsAt        DateTime
  endsAt          DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  event        Event         @relation(fields: [eventId], references: [id])
  transactions Transaction[]

  @@index([eventId, startsAt, endsAt, deletedAt])
}

model Transaction {
  id                 String            @id @default(cuid())
  invoiceNumber      String            @unique
  customerId         String
  eventId            String
  voucherId          String?
  userCouponId       String?           @unique
  status             TransactionStatus @default(WAITING_FOR_PAYMENT)
  subtotal           Int
  pointsUsed         Int               @default(0)
  voucherDiscount    Int               @default(0)
  couponDiscount     Int               @default(0)
  total              Int
  paymentDeadline    DateTime
  organizerDeadline  DateTime?
  paymentUploadedAt  DateTime?
  completedAt        DateTime?
  canceledAt         DateTime?
  cancellationReason String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  customer     User              @relation("CustomerTransactions", fields: [customerId], references: [id])
  event        Event             @relation(fields: [eventId], references: [id])
  voucher      Voucher?          @relation(fields: [voucherId], references: [id])
  userCoupon   UserCoupon?       @relation(fields: [userCouponId], references: [id])
  items        TransactionItem[]
  paymentProof PaymentProof?
  pointEntries PointLedger[]
  review       Review?

  @@index([customerId, status])
  @@index([eventId, status])
  @@index([status, paymentDeadline])
  @@index([status, organizerDeadline])
}

model TransactionItem {
  id            String @id @default(cuid())
  transactionId String
  ticketTypeId  String
  quantity      Int
  unitPrice     Int
  subtotal      Int

  transaction Transaction @relation(fields: [transactionId], references: [id])
  ticketType  TicketType  @relation(fields: [ticketTypeId], references: [id])

  @@unique([transactionId, ticketTypeId])
  @@index([ticketTypeId])
}

model PaymentProof {
  id            String   @id @default(cuid())
  transactionId String   @unique
  fileUrl       String
  publicId      String
  mimeType      String
  fileSize      Int
  uploadedAt    DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id])
}

model Review {
  id            String    @id @default(cuid())
  transactionId String    @unique
  eventId       String
  customerId    String
  rating        Int
  comment       String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  transaction Transaction @relation(fields: [transactionId], references: [id])
  event       Event       @relation(fields: [eventId], references: [id])
  customer    User        @relation(fields: [customerId], references: [id])

  @@index([eventId, deletedAt])
  @@index([customerId, deletedAt])
}
